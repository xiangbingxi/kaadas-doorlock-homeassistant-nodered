        "func": "var arr = msg.payload.data.wifiList;\n\nif (!arr || arr.length === 0) {\n    return null;\n}\n\nvar powerVal = arr[0].power !== undefined ? String(arr[0].power) : \"100\";\n\nmsg.payload = {\n    \"state\": powerVal,\n    \"power\": powerVal,\n    \"productModel\": arr[0].productModel || \"\",\n    \"lockNickname\": arr[0].lockNickname || \"\",\n    \"adminName\": arr[0].adminName || \"\",\n    \"wifiAddress\": arr[0].wifiAddress || \"\",\n    \"camera_version\": arr[0].camera_version || \"\",\n    \"wifiName\": arr[0].wifiName || \"\",\n    \"openCount\": arr[0].openCount !== undefined ? String(arr[0].openCount) : \"0\"\n};\n\nreturn msg;",
