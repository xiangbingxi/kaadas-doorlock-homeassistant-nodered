        "id": "e73a7f421a63275b",
        "type": "function",
        "z": "aa7a5ecfb8874398",
        "name": "提取最近抓拍图",
        "func": "var arr = msg.payload.data;\n\nif (!arr || !Array.isArray(arr) || arr.length === 0) {\n    return null;\n}\n\nvar targetRecord = null;\nfor (var i = 0; i < arr.length; i++) {\n    var item = arr[i];\n    var img = item.thumbUrl || item.picUrl || item.imgUrl || item.snapshotUrl || \"\";\n    if (img && img.trim() !== \"\") {\n        targetRecord = item;\n        targetRecord.extractedImgUrl = img;\n        break;\n    }\n}\n\nif (!targetRecord) {\n    return null;\n}\n\nvar lastTime = Number(targetRecord.time);\nvar previousTime = context.get('lastVisitorTime') || 0;\n\nif (lastTime !== previousTime) {\n    context.set('lastVisitorTime', lastTime);\n    global.set('lastGlobalCameraTime', lastTime);\n\n    msg.payload = {\n        \"lastTime\": lastTime,\n        \"lastTextContent\": targetRecord.textContent || \"有人按门铃\",\n        \"lastImgUrl\": targetRecord.extractedImgUrl\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
