    {
        "id": "24c65eb84f8caf19",
        "type": "function",
        "z": "aa7a5ecfb8874398",
        "name": "提取最近一条消息",
        "func": "var arr = msg.payload.data;\n\nif (!arr || arr.length === 0) {\n    return null;\n}\n\nvar lastTime = arr[0].time;\nvar lastTextContent = arr[0].textContent || \"门锁新动态\";\nvar lastImgUrl = arr[0].picUrl \n              || arr[0].imgUrl \n              || arr[0].snapshotUrl \n              || arr[0].picture \n              || arr[0].fileUrl \n              || arr[0].mediaUrl \n              || arr[0].alarmPic \n              || \"\";\n\nvar previousTime = context.get('lastPushedTime') || \"\";\n\nif (lastTime && lastTime !== previousTime) {\n    context.set('lastPushedTime', lastTime);\n\n    msg.payload = {\n        \"lastTime\": lastTime,\n        \"lastTextContent\": lastTextContent,\n        \"lastImgUrl\": lastImgUrl\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
