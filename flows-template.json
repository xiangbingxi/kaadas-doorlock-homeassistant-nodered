        "name": "获取最近门锁事件",
        "func": "// =========================================================\n// 【必填项 1】：填入抓包获取的凯迪仕 token 和门锁 wifiSN 序列号\n// =========================================================\nmsg.headers = {\n    'Host': 'app.kaadas.com:34000',\n    'token' : 'YOUR_KAADAS_TOKEN', // 👈 替换为你的真实 Token\n    'ver': '20231127',\n    'Content-Length': '35',\n    'reqSource': 'app',\n    'phoneName': 'iPhone',\n    'lang': 'zh_CN',\n    'User-Agent': 'KaadasLock/6.14.3 (iPhone; iOS 27.0; Scale/3.00)',\n    'Connection' : 'keep-alive',\n    'Content-Type' : 'application/json'\n};\n\nmsg.payload = {\n    \"wifiSN\": \"YOUR_LOCK_WIFI_SN\", // 👈 替换为你的门锁 SN\n    \"page\": 1\n};\nreturn msg;",
